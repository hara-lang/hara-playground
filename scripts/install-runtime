#!/usr/bin/env bash
set -euo pipefail

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
LOCK="$ROOT/runtime.lock.json"
DEST="$ROOT/.runtime"
ARCHIVE=${HARA_STUDIO_RUNTIME_ARCHIVE:-}

read_lock() {
  node -e 'const x=require(process.argv[1]); console.log(x[process.argv[2]])' "$LOCK" "$1"
}

VERSION=$(read_lock version)
EXPECTED=$(read_lock sha256)
if [ -z "$ARCHIVE" ]; then
  ARCHIVE="${RUNNER_TEMP:-/tmp}/hara-studio-runtime-$VERSION.tar.gz"
  curl --fail --location --retry 3 --output "$ARCHIVE" "$(read_lock url)"
fi

if command -v sha256sum >/dev/null 2>&1; then
  ACTUAL=$(sha256sum "$ARCHIVE" | cut -d ' ' -f 1)
else
  ACTUAL=$(shasum -a 256 "$ARCHIVE" | cut -d ' ' -f 1)
fi
[ "$ACTUAL" = "$EXPECTED" ] || { echo "runtime checksum mismatch" >&2; exit 1; }

rm -rf "$DEST"
mkdir -p "$DEST"
tar -xzf "$ARCHIVE" -C "$DEST"
