(ns playground.hodos-graph)

(def flow
  {:source 21
   :operation :double
   :result 42})

(defn view []
  [:main {:class "preview-shell"}
   [:article {:class "card"}
    [:span {:class "eyebrow"} "HODOS 2D GRAPH"]
    [:h1 "Typed flow"]
    [:p "Source 21 flows through double to result 42."]]])

(view)
