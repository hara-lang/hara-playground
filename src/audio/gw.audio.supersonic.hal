(ns gw.audio.supersonic)

;; This browser compatibility namespace deliberately calls the built-in Host
;; boundary directly. Requiring std.foundation.host here would make the first
;; audio namespace depend on the larger Foundation bootstrap before a project
;; can start its graph.

(defn start [graph]
  @(Host/call "gw.audio.supersonic" "start" [graph]))

(defn update [graph-id node parameter value]
  @(Host/call "gw.audio.supersonic" "update"
              [graph-id node parameter value]))

(defn status [graph-id]
  @(Host/call "gw.audio.supersonic" "status" [graph-id]))

(defn stop [graph-id]
  @(Host/call "gw.audio.supersonic" "stop" [graph-id]))
