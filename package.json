{
  "name": "@hara-lang/playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The browser-native Hara Playground and live Studio environment.",
  "scripts": {
    "web:prepare": "node scripts/prepare-web-packages.mjs",
    "predev": "npm run web:prepare",
    "dev": "node scripts/dev-server.mjs",
    "pretest": "npm run web:prepare",
    "test": "node --test tests/*.test.js",
    "precheck": "npm run web:prepare",
    "samples:validate": "node scripts/validate-samples.mjs",
    "check": "node scripts/check.mjs && npm run samples:validate",
    "runtime:install": "node scripts/install-runtime.mjs",
    "prebuild": "npm run web:prepare",
    "build": "node scripts/build-site.mjs",
    "runtime:download": "bash scripts/install-pinned-runtime",
    "validate": "npm run check && npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "EPL-2.0"
}
